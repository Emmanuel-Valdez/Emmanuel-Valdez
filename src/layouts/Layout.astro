---
interface Props {
  title: string;
  description: string;
  image?: string;
  locale?: 'es' | 'en';
  alternatePath?: string;
}

const { title, description, image = '/2024.webp', locale = 'es', alternatePath } = Astro.props;
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const alternateUrl = Astro.site && alternatePath ? new URL(alternatePath, Astro.site).toString() : undefined;
const socialImageUrl = Astro.site ? new URL(image, Astro.site).toString() : undefined;
const ogLocale = locale === 'es' ? 'es_AR' : 'en_US';
const alternateOgLocale = locale === 'es' ? 'en_US' : 'es_AR';
const jsonLdPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Emmanuel Valdez',
  url: 'https://evaldez.ar/',
  jobTitle: 'Software Engineer .NET',
  description:
    locale === 'es'
      ? 'Software Engineer .NET en Mendoza. VaultShop: e-commerce en ASP.NET Core con PostgreSQL, Docker, pagos con Stripe y Mercado Pago, 821 tests y deploy propio.'
      : 'Software Engineer .NET based in Mendoza. VaultShop: an ASP.NET Core e-commerce app with PostgreSQL, Docker, Stripe and Mercado Pago payments, 821 tests, and my own deploy.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mendoza',
    addressCountry: 'AR',
  },
  sameAs: [
    'https://github.com/Emmanuel-Valdez',
    'https://www.linkedin.com/in/evaldezdev/',
  ],
};
import '@fontsource-variable/onest';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { common } from '@/data/i18n';

const copy = common[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Emmanuel Valdez" />
    <meta name="theme-color" content="#020617" />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js-theme');
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f6f3ea' : '#020617');
        } catch (error) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={alternateUrl} />}
    {canonicalUrl && <link rel="alternate" hreflang={locale} href={canonicalUrl} />}
    {locale === 'es' && canonicalUrl && <link rel="alternate" hreflang="x-default" href={canonicalUrl} />}
    {locale === 'en' && alternateUrl && <link rel="alternate" hreflang="x-default" href={alternateUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://github.com" />
    <link rel="preload" as="image" href="/projects/vaultshop/storefront.webp" type="image/webp" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)}></script>
    <!-- ponytail: Plausible privacy-friendly analytics, no cookie banner; create account for evaldez.ar to see data -->
    <script defer data-domain="evaldez.ar" src="https://plausible.io/js/script.outbound-links.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <div
      aria-hidden="true"
      class="ambient-glow absolute top-0 z-[-2] h-screen w-full"
    >
    </div>
    <Header locale={locale} alternatePath={alternatePath} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
<style is:global>
  html {
    font-family: 'Onest Variable', system-ui, sans-serif;
    scroll-behavior: smooth;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overscroll-behavior: none;
    background: var(--color-canvas);
    color: var(--color-body);
  }
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    scroll-margin-top: 6rem;
    scroll-margin-bottom: 2rem;
  }
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 50;
    transform: translateY(-200%);
    border-radius: 9999px;
    background: var(--color-canvas);
    color: var(--color-ink);
    padding: 0.5rem 1rem;
    transition: transform 150ms ease;
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    html {
      scroll-behavior: auto;
    }
  }
</style>
