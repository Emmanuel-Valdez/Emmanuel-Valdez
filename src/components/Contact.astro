---
import LinkButton from '@/components/LinkButton.astro';
import DownloadIcon from '@/icons/Download.astro';
import MailIcon from '@/icons/MailIcon.astro';

interface Props {
  content: {
    text: string;
    cvLabel: string;
    cv: {
      href: string;
      download: string;
    };
  };
}

const { content } = Astro.props;
---

<div>
  <p class="my-10">
    {content.text}
  </p>
  <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
    <LinkButton href="mailto:evalmon.dev@gmail.com" class="justify-center sm:justify-start">
      <MailIcon class="size-4 md:size-6" />
      evalmon.dev@gmail.com
    </LinkButton>

    <LinkButton download={content.cv.download} href={content.cv.href} class="justify-center sm:justify-start"
      ><DownloadIcon class="size-4 md:size-6" />{content.cvLabel}
    </LinkButton>
  </div>
</div>
