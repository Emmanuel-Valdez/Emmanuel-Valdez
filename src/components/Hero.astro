---
import LinkedInIcon from '@/icons/LinkedInIcon.astro';
import GitHubIcon from '@/icons/GitHubIcon.astro';
import MailIcon from '@/icons/MailIcon.astro';
import SocialPill from '@/components/SocialPill.astro';
import Avatar from '@/components/Avatar.astro';
import DownloadIcon from '@/icons/Download.astro';

interface Props {
  content: {
    name: string;
    brandLine: string;
    title: string;
    lines: readonly {
      text: string;
      class?: string;
    }[];
    stackAriaLabel: string;
    stack: readonly string[];
    availabilityLabel: string;
    ctas: {
      ariaLabel: string;
      project: string;
      projectHref: string;
      contact: string;
      contactHref: string;
      cv: string;
      cvFile: {
        href: string;
        download: string;
      };
    };
    recruiter: {
      title: string;
      ariaLabel: string;
      items: readonly {
        label: string;
        value: string;
      }[];
    };
    socialAriaLabel: string;
  };
}

const { content } = Astro.props;
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <Avatar availabilityLabel={content.availabilityLabel} />
  </div>
  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-sky-200/80 sm:text-sm">
    {content.brandLine}
  </p>
  <h1
    class="text-white text-4xl font-bold leading-tight tracking-tight md:text-5xl lg:text-6xl"
  >
    {content.name}
  </h1>
  <p class="mt-4 max-w-[620px] text-2xl font-semibold leading-tight text-slate-100 md:text-3xl">
    {content.title}
  </p>
  <h2 class="mt-6 text-xl lg:text-2xl text-wrap max-w-[560px]">
    {content.lines.map((line) => <span class={line.class}>{line.text}</span>)}
  </h2>
  <ul class="mt-5 flex flex-wrap gap-2" aria-label={content.stackAriaLabel}>
    {
      content.stack.map((item) => (
        <li class="rounded-full border border-white/[0.08] bg-white/[0.02] px-2.5 py-1 text-xs font-medium tracking-wide text-gray-300/85">
          {item}
        </li>
      ))
    }
  </ul>
  <nav class="flex gap-3 mt-8 flex-wrap" aria-label={content.ctas.ariaLabel}>
    <a
      class="inline-flex items-center justify-center rounded-full border border-sky-300/50 bg-sky-300 px-4 py-2 text-sm font-semibold text-slate-950 shadow-lg shadow-sky-950/30 transition hover:-translate-y-0.5 hover:bg-sky-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300 md:px-5 md:py-2.5 md:text-base"
      href={content.ctas.projectHref}
    >
      {content.ctas.project}
    </a>
    <a
      class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-white/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300 md:px-5 md:py-2.5 md:text-base"
      download={content.ctas.cvFile.download}
      href={content.ctas.cvFile.href}
    >
      <DownloadIcon class="size-4 md:size-6" />
      {content.ctas.cv}
    </a>
    <a
      class="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 px-4 py-2 text-sm font-medium text-gray-300 transition hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/[0.04] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300 md:px-5 md:py-2.5 md:text-base"
      href={content.ctas.contactHref}
    >
      <MailIcon class="size-4 md:size-6" />
      {content.ctas.contact}
    </a>
  </nav>
  <aside
    class="mt-8 border-y border-white/10 bg-white/[0.025] py-4"
    aria-label={content.recruiter.ariaLabel}
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-5">
      <p class="shrink-0 text-xs font-semibold uppercase tracking-[0.18em] text-sky-200/80">
        {content.recruiter.title}
      </p>
      <dl class="flex flex-1 flex-col gap-2 text-sm sm:flex-row sm:flex-wrap sm:gap-x-4 sm:gap-y-2">
        {
          content.recruiter.items.map((item) => (
            <div class="flex items-baseline gap-2 leading-snug">
              <dt class="text-xs font-medium text-gray-500">{item.label}</dt>
              <dd class="font-medium text-gray-200">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </aside>
  <nav class="flex gap-4 mt-8 flex-wrap" aria-label={content.socialAriaLabel}>
    <SocialPill href="https://www.linkedin.com/in/emmanuelvaldezdev/">
      <LinkedInIcon class="size-4 md:size-6" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/Emmanuel-Valdez">
      <GitHubIcon class="size-4 md:size-6" />
      GitHub
    </SocialPill>
  </nav>
</div>
