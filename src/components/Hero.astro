---
import LinkedInIcon from '@/icons/LinkedInIcon.astro';
import GitHubIcon from '@/icons/GitHubIcon.astro';
import MailIcon from '@/icons/MailIcon.astro';
import SocialPill from '@/components/SocialPill.astro';
import Avatar from '@/components/Avatar.astro';
import DownloadIcon from '@/icons/Download.astro';

interface Props {
  content: {
    title: string;
    lines: readonly {
      text: string;
      class?: string;
    }[];
    stackAriaLabel: string;
    stack: readonly string[];
    availabilityLabel: string;
    ctas: {
      ariaLabel: string;
      project: string;
      projectHref: string;
      contact: string;
      contactHref: string;
      cv: string;
      cvFile: {
        href: string;
        download: string;
      };
    };
  };
}

const { content } = Astro.props;
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <Avatar availabilityLabel={content.availabilityLabel} />
  </div>
  <h1
    class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-6 lg:pb-10"
  >
    {content.title}
  </h1>
  <h2 class="text-xl lg:text-2xl text-wrap max-w-[560px]">
    {content.lines.map((line) => <span class={line.class}>{line.text}</span>)}
  </h2>
  <ul class="mt-6 flex flex-wrap gap-2" aria-label={content.stackAriaLabel}>
    {
      content.stack.map((item) => (
        <li class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm text-gray-200">
          {item}
        </li>
      ))
    }
  </ul>
  <nav class="flex gap-4 mt-8 flex-wrap" aria-label={content.ctas.ariaLabel}>
    <SocialPill href={content.ctas.projectHref}>
      {content.ctas.project}
    </SocialPill>
    <SocialPill href={content.ctas.contactHref}>
      <MailIcon class="size-4 md:size-6" />
      {content.ctas.contact}
    </SocialPill>
    <SocialPill download={content.ctas.cvFile.download} href={content.ctas.cvFile.href}>
      <DownloadIcon class="size-4 md:size-6" />
      {content.ctas.cv}
    </SocialPill>
  </nav>
  <nav class="flex gap-4 mt-8 flex-wrap">
    <SocialPill href="https://www.linkedin.com/in/evalmondev/">
      <LinkedInIcon class="size-4 md:size-6" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/Emmanuel-Valdez">
      <GitHubIcon class="size-4 md:size-6" />
      GitHub
    </SocialPill>
    <SocialPill href="mailto:evalmon.dev@gmail.com">
      <MailIcon class="size-4 md:size-6" />
      evalmon.dev@gmail.com
    </SocialPill>
  </nav>
</div>
