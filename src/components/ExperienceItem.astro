---
import LinkButton from './LinkButton.astro';
import IconArrow from '../icons/Arrow.astro';

interface Props {
  title: string;
  description: string;
  highlights?: string[];
  link?: string;
  date: string;
  company?: string;
}
const { title, description, highlights = [], link, date, company } = Astro.props;
---

<div
  class="absolute w-3 h-3 rounded-full mt-1.5 -start-1.5 border border-gray-900 bg-gray-700"
>
</div>
<time class="mb-1 text-sm font-normal leading-none text-sky-200/80">{date}</time
>
<h3 class="text-lg font-semibold">{company}</h3>
<h3 class="text-lg font-semibold text-yellow-200 mt-2">
  {title}
</h3>

<p class="mb-4 text-base font-normal text-gray-200 text-pretty">
  {description}
</p>
{
  highlights.length > 0 && (
    <ul class="mb-4 space-y-2 text-sm leading-6 text-gray-300">
      {highlights.map((highlight) => (
        <li class="flex gap-3">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
          <span>{highlight}</span>
        </li>
      ))}
    </ul>
  )
}
{
  link && (
    <LinkButton href={link} target="_blank" rel="noopener noreferrer">
      Saber más... <IconArrow />
    </LinkButton>
  )
}
