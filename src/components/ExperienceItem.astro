---
import LinkButton from './LinkButton.astro';
import IconArrow from '../icons/Arrow.astro';

interface Props {
  title: string;
  description: string;
  highlights?: readonly string[];
  tags?: readonly string[];
  tagsAriaLabel?: string;
  link?: string;
  linkLabel?: string;
  date: string;
  company?: string;
}
const {
  title,
  description,
  highlights = [],
  tags = [],
  tagsAriaLabel = 'Experience areas',
  link,
  linkLabel = 'View',
  date,
  company,
} = Astro.props;
---

<div
  class="absolute mt-1.5 size-3 rounded-full -start-1.5 border border-gray-900 bg-amber-400 shadow-lg shadow-black/40"
  aria-hidden="true"
>
</div>
<article class="rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
  <time class="text-sm font-medium leading-none text-amber-300/80">{date}</time>
  <div class="mt-3 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="text-xl font-bold text-white">{company}</h3>
    <p class="text-sm font-semibold text-yellow-200">{title}</p>
  </div>

  <p class="mt-4 text-pretty text-sm leading-7 text-gray-300 sm:text-base">
    {description}
  </p>

  {
    tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2" aria-label={tagsAriaLabel}>
        {tags.map((tag) => (
          <li class="rounded-full border border-blue-400/15 bg-blue-400/10 px-3 py-1 text-xs font-medium text-slate-100">
            {tag}
          </li>
        ))}
      </ul>
    )
  }

  {
    highlights.length > 0 && (
      <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300">
        {highlights.map((highlight) => (
          <li class="flex gap-3">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-amber-400" aria-hidden="true"></span>
            <span>{highlight}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    link && (
      <div class="mt-6">
        <LinkButton href={link}>
          {linkLabel} <IconArrow />
        </LinkButton>
      </div>
    )
  }
</article>
