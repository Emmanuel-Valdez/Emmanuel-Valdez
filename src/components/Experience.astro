---
import ExperienceItem from './ExperienceItem.astro';

const EXPERIENCE = [
  {
    date: '2020 - Actualmente...',
    title: 'Gestión de plataformas e-commerce y procesos de negocio',
    company: 'Ukiyo Mochilas y algo más',
    description:
      'Administración operativa de las plataformas web del negocio, conectando catálogo, stock, publicaciones, ventas, atención al cliente, datos comerciales, logística y mejora de procesos internos.',
    highlights: [
      'Gestión de plataformas e-commerce, incluyendo catálogo, stock, publicaciones, ventas y migración desde Tienda Nube hacia Tienda Negocio.',
      'Seguimiento de pedidos, coordinación logística y revisión de datos para decisiones comerciales.',
      'Base práctica para desarrollar Ukiyo como sistema propio de e-commerce, costos, precios y gestión administrativa.',
    ],
    link: 'https://ukiyo.tiendanegocio.com/',
  },
];
---

<ol class="relative border-s border-gray-200 ml-3">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
