---
import LinkButton from './LinkButton.astro';
import IconArrow from '../icons/Arrow.astro';

interface Props {
  items: readonly {
    date: string;
    title: string;
    company: string;
    description: string;
    highlights: readonly string[];
    tags: readonly string[];
    tagsAriaLabel: string;
    link: string;
    linkLabel: string;
  }[];
}

const { items } = Astro.props;
---

<ol class="relative border-s border-line ml-3">
  {
    items.map(({ date, company, title, description, tags, tagsAriaLabel, highlights, link, linkLabel }) => (
      <li class="mb-10 ms-4">
        <div
          class="absolute mt-1.5 size-3 rounded-full -start-1.5 border border-canvas bg-amber-400 shadow-lg shadow-umbra/40"
          aria-hidden="true"
        >
        </div>
        <article class="rounded-3xl border border-line bg-surface p-5 sm:p-6">
          <time class="text-sm font-medium leading-none text-accent">{date}</time>
          <div class="mt-3 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-xl font-bold text-ink">{company}</h3>
            <p class="text-sm font-semibold text-accent">{title}</p>
          </div>

          <p class="mt-4 text-pretty text-sm leading-7 text-body sm:text-base">
            {description}
          </p>

          {tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={tagsAriaLabel}>
              {tags.map((tag) => (
                <li class="rounded-full border border-line bg-info-soft px-3 py-1 text-xs font-medium text-ink">
                  {tag}
                </li>
              ))}
            </ul>
          )}

          {highlights.length > 0 && (
            <ul class="mt-5 space-y-3 text-sm leading-6 text-body">
              {highlights.map((highlight) => (
                <li class="flex gap-3">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-amber-400" aria-hidden="true"></span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          )}

          {link && (
            <div class="mt-6">
              <LinkButton href={link}>
                {linkLabel} <IconArrow />
              </LinkButton>
            </div>
          )}
        </article>
      </li>
    ))
  }
</ol>
