---
import { common, routes, type Locale } from '@/data/i18n';

interface Props {
  locale?: Locale;
  alternatePath?: string;
}

const { locale = 'es', alternatePath } = Astro.props;
const copy = common[locale];
const homeHref = routes[locale].home;
const languageHref = alternatePath ?? copy.language.alternateHref;
const spanishHref = locale === 'es' ? Astro.url.pathname : languageHref;
const englishHref = locale === 'en' ? Astro.url.pathname : languageHref;
---

<header
  class="fixed top-0 z-10 flex w-full items-center justify-center px-2 pt-2"
>
  <nav
    aria-label={copy.headerAriaLabel}
    class="flex max-w-full flex-row items-center overflow-x-auto rounded-full border border-black bg-black/70 px-2 py-1 text-xs backdrop-blur-2xl sm:px-3 sm:text-base"
  >
    <a class="inline-flex min-h-9 items-center whitespace-nowrap rounded-full px-2 transition hover:bg-white/10 hover:text-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:min-h-10 sm:px-3" href={`${homeHref}#projects`}
      >{copy.nav.projects}</a
    >
    <a class="inline-flex min-h-9 items-center whitespace-nowrap rounded-full px-2 transition hover:bg-white/10 hover:text-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:min-h-10 sm:px-3" href={`${homeHref}#experience`}
      >{copy.nav.experience}</a
    >
    <a class="inline-flex min-h-9 items-center whitespace-nowrap rounded-full px-2 transition hover:bg-white/10 hover:text-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:min-h-10 sm:px-3" href={`${homeHref}#about`}
      >{copy.nav.about}</a
    >
    <a class="inline-flex min-h-9 items-center whitespace-nowrap rounded-full px-2 transition hover:bg-white/10 hover:text-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:min-h-10 sm:px-3" href={`${homeHref}#contact`}
      >{copy.nav.contact}</a
    >
    <div
      aria-label={copy.language.label}
      class="ml-1 inline-flex items-center rounded-full border border-white/10 bg-white/5 p-0.5 text-[0.68rem] font-semibold sm:text-xs"
      role="group"
    >
      <a
        aria-current={locale === 'es' ? 'page' : undefined}
        class={`inline-flex min-h-8 items-center rounded-full px-2 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 ${locale === 'es' ? 'bg-sky-300 text-slate-950 shadow-sm shadow-sky-950/40' : 'text-sky-100 hover:bg-white/10 hover:text-white'}`}
        href={spanishHref}
        hreflang="es"
      >ES</a>
      <a
        aria-current={locale === 'en' ? 'page' : undefined}
        class={`inline-flex min-h-8 items-center rounded-full px-2 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 ${locale === 'en' ? 'bg-sky-300 text-slate-950 shadow-sm shadow-sky-950/40' : 'text-sky-100 hover:bg-white/10 hover:text-white'}`}
        href={englishHref}
        hreflang="en"
      >EN</a>
    </div>
  </nav>
</header>
