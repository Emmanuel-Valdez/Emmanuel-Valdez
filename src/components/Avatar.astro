---
import Badge from '@/components/Badge.astro';

interface Props {
  availabilityLabel: string;
}

const { availabilityLabel } = Astro.props;
---



<img
  class="size-16 rounded-full object-cover object-[50%_18%] p-1 mb-4 ring-2 ring-gray-300 ring-indigo-700"
  src="/EmmanuelSaco.jpg"
  alt="Foto de perfil de Emmanuel Valdez"
/>
<a
  href="https://www.linkedin.com/in/evalmondev/"
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center transition justify-center hover:scale-105"
>
  <Badge>{availabilityLabel}</Badge>
</a>
