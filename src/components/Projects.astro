---
import NodeJSIcon from '../icons/techIcons/NodeJS.astro';
import CSharpIcon from '../icons/techIcons/CSharp.astro';
import ExpressIcon from '../icons/techIcons/Express.astro';
import MySQLIcon from '../icons/techIcons/MySQL.astro';
import GitHubIcon from '@/icons/techIcons/GitHub.astro';
import LinkButton from './LinkButton.astro';
import WebIcon from '@/icons/Web.astro';
import MSSQLIcon from '@/icons/techIcons/MSSQL.astro';

interface Tag {
  name: string;
  class: string;
  icon?: typeof NodeJSIcon;
}

const TAGS = {
  NodeJS: {
    name: 'Node.js',
    class: 'bg-black text-[#fafafa]',
    icon: NodeJSIcon,
  },
  CSharp: {
    name: 'C#',
    class: 'bg-black text-[#fafafa]',
    icon: CSharpIcon,
  },
  Express: {
    name: 'Express',
    class: 'bg-black text-[#fafafa]',
    icon: ExpressIcon,
  },
  MySQL: {
    name: 'MySQL',
    class: 'bg-black text-[#fafafa]',
    icon: MySQLIcon,
  },
  GitHub: {
    name: 'GitHub',
    class: 'bg-black text-[#fafafa]',
    icon: GitHubIcon,
  },
  MSSQL: {
    name: 'MS SQL',
    class: 'bg-black text-[#fafafa]',
    icon: MSSQLIcon,
  },
  PostgreSQL: {
    name: 'PostgreSQL',
    class: 'bg-[#336791] text-[#fafafa]',
    icon: MSSQLIcon,
  },
  Astro: {
    name: 'Astro',
    class: 'bg-black text-[#fafafa]',
  },
  TypeScript: {
    name: 'TypeScript',
    class: 'bg-[#3178c6] text-[#fafafa]',
  },
  Tailwind: {
    name: 'Tailwind CSS',
    class: 'bg-[#0f172a] text-sky-200',
  },
  SQLite: {
    name: 'SQLite',
    class: 'bg-[#003b57] text-[#fafafa]',
  },
  OpenSpec: {
    name: 'OpenSpec',
    class: 'bg-[#1e293b] text-[#fde68a]',
  },
} satisfies Record<string, Tag>;
type TagKey = keyof typeof TAGS;

interface Project {
  title: string;
  eyebrow?: string;
  description: string;
  stack?: readonly string[];
  highlights?: readonly string[];
  metrics?: readonly {
    value: string;
    label: string;
  }[];
  link: string;
  github: string;
  image: string;
  imageMobile?: string;
  imageAlt: string;
  tags: readonly TagKey[];
}

interface Props {
  content: {
    featuredStudyLabel: string;
    featuredStudyHref: string;
    supportingLabel: string;
    stackAriaPrefix: string;
    metricsAriaPrefix: string;
    buttons: {
      code: string;
      preview: string;
    };
    items: readonly Project[];
  };
}

const { content } = Astro.props;
const PROJECTS = content.items;

const [FEATURED_PROJECT, ...SUPPORTING_PROJECTS] = PROJECTS;
const FEATURED_STACK = FEATURED_PROJECT.stack ?? [];
const FEATURED_HIGHLIGHTS = FEATURED_PROJECT.highlights ?? [];
const FEATURED_METRICS = FEATURED_PROJECT.metrics ?? [];
---

<div class="flex flex-col gap-y-12">
  <article class="group relative overflow-hidden rounded-3xl border border-line bg-panel shadow-2xl shadow-umbra/30">
    <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-accent to-transparent" aria-hidden="true"></div>
    <div class="grid gap-8 p-5 md:grid-cols-[1.05fr_0.95fr] md:p-7 lg:p-8">
      <div class="relative overflow-hidden rounded-2xl border border-line bg-media">
        <a
          class="block h-full w-full cursor-zoom-in focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          href={FEATURED_PROJECT.imageMobile ?? FEATURED_PROJECT.image}
          target="_blank"
          rel="noopener noreferrer"
        >
          {FEATURED_PROJECT.imageMobile ? (
            <>
              <img
                alt={FEATURED_PROJECT.imageAlt}
                class="h-full min-h-72 w-full object-cover object-top transition duration-500 md:group-hover:scale-[1.03] md:hidden"
                loading="lazy"
                src={FEATURED_PROJECT.image}
              />
              <img
                alt={FEATURED_PROJECT.imageAlt}
                class="hidden h-full min-h-72 w-full object-cover object-top transition duration-500 md:block md:group-hover:scale-[1.03]"
                loading="lazy"
                src={FEATURED_PROJECT.imageMobile}
              />
            </>
          ) : (
            <img
              alt={FEATURED_PROJECT.imageAlt}
              class="h-full min-h-72 w-full object-cover object-top transition duration-500 md:group-hover:scale-[1.03]"
              loading="lazy"
              src={FEATURED_PROJECT.image}
            />
          )}
        </a>
      </div>

      <div class="flex flex-col justify-center">
        <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-accent">
          {FEATURED_PROJECT.eyebrow}
        </p>
        <h3 class="text-3xl font-bold text-ink md:text-4xl">
          {FEATURED_PROJECT.title}
        </h3>
        <p class="mt-4 text-pretty text-body">
          {FEATURED_PROJECT.description}
        </p>

        <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${content.stackAriaPrefix} ${FEATURED_PROJECT.title}`}>
          {FEATURED_STACK.map((item) => (
            <li class="rounded-full border border-line bg-info-soft px-2.5 py-1 text-xs font-medium text-ink">
              {item}
            </li>
          ))}
        </ul>

        <ul class="mt-5 space-y-3 text-sm text-ink">
          {FEATURED_HIGHLIGHTS.map((highlight) => (
            <li class="flex gap-x-3">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-amber-400" aria-hidden="true" />
              <span>{highlight}</span>
            </li>
          ))}
        </ul>

        {FEATURED_METRICS.length > 0 && (
          <ul
            class="mt-6 grid grid-cols-2 gap-2 border-y border-line py-4 sm:grid-cols-3"
            aria-label={`${content.metricsAriaPrefix} ${FEATURED_PROJECT.title}`}
          >
            {FEATURED_METRICS.map((metric) => (
              <li class="rounded-2xl border border-line bg-panel-2 px-3 py-3 shadow-inner shadow-umbra/20 transition duration-300 hover:border-accent-line hover:bg-accent-soft">
                <span class="block text-lg font-bold leading-none text-accent">{metric.value}</span>
                <span class="mt-1 block text-[0.68rem] font-medium uppercase leading-tight tracking-[0.08em] text-muted">
                  {metric.label}
                </span>
              </li>
            ))}
          </ul>
        )}

        <footer class="mt-6 flex flex-wrap items-center gap-4">
          <LinkButton
            href={content.featuredStudyHref}
            aria-label={`${content.featuredStudyLabel}: ${FEATURED_PROJECT.title}`}
            class="border-accent-line bg-accent-soft text-accent shadow-lg shadow-amber-950/30 hover:border-accent-line hover:bg-accent-soft hover:text-ink focus:ring-accent-ring"
          >
            {content.featuredStudyLabel}
          </LinkButton>
          {FEATURED_PROJECT.link && (
            <LinkButton
              href={FEATURED_PROJECT.link}
              aria-label={`${content.buttons.preview}: ${FEATURED_PROJECT.title}`}
            >
              <WebIcon class="size-5" />
              {content.buttons.preview}
            </LinkButton>
          )}
          {FEATURED_PROJECT.github && (
            <LinkButton
              href={FEATURED_PROJECT.github}
              aria-label={`${content.buttons.code}: ${FEATURED_PROJECT.title}`}
            >
              <GitHubIcon class="size-5" />
              {content.buttons.code}
            </LinkButton>
          )}
        </footer>
      </div>
    </div>
  </article>

  <div>
    <p class="mb-6 text-sm font-medium uppercase tracking-[0.2em] text-muted">
      {content.supportingLabel}
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      {
        SUPPORTING_PROJECTS.map(({ image, imageAlt, title, description, tags, link, github }) => (
          <article class="group overflow-hidden rounded-2xl border border-line bg-surface transition duration-300 hover:border-accent-line hover:bg-surface-2">
            <div class="overflow-hidden border-b border-line">
              <img
                alt={imageAlt}
                class="h-48 w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                src={image}
              />
            </div>

            <div class="p-5">
              <h3 class="text-xl font-bold text-ink">{title}</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {tags.map((tagKey) => {
                  const tag: Tag = TAGS[tagKey];
                  return (
                  <li>
                    <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} px-2 py-1`}>
                      {tag.icon && <tag.icon class="size-4" />}
                      {tag.name}
                    </span>
                  </li>
                  );
                })}
              </ul>

              <p class="mt-4 text-sm text-muted">{description}</p>
              <footer class="mt-5 flex flex-wrap items-center gap-3">
                {github && (
                  <LinkButton href={github} aria-label={`${content.buttons.code}: ${title}`}>
                    <GitHubIcon class="size-5" />
                    {content.buttons.code}
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link} aria-label={`${content.buttons.preview}: ${title}`}>
                    <WebIcon class="size-5" />
                    {content.buttons.preview}
                  </LinkButton>
                )}
              </footer>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</div>
