---
import NodeJSIcon from '../icons/techIcons/NodeJS.astro';
import CSharpIcon from '../icons/techIcons/CSharp.astro';
import ExpressIcon from '../icons/techIcons/Express.astro';
import MySQLIcon from '../icons/techIcons/MySQL.astro';
import GitHubIcon from '@/icons/techIcons/GitHub.astro';
import LinkButton from './LinkButton.astro';
import WebIcon from '@/icons/Web.astro';
import MSSQLIcon from '@/icons/techIcons/MSSQL.astro';

const TAGS = {
  NodeJS: {
    name: 'Node.js',
    class: 'bg-black text-white',
    icon: NodeJSIcon,
  },
  CSharp: {
    name: 'C#',
    class: 'bg-black text-white',
    icon: CSharpIcon,
  },
  Express: {
    name: 'Express',
    class: 'bg-black text-white',
    icon: ExpressIcon,
  },
  MySQL: {
    name: 'MySQL',
    class: 'bg-black text-white',
    icon: MySQLIcon,
  },
  GitHub: {
    name: 'GitHub',
    class: 'bg-black text-white',
    icon: GitHubIcon,
  },
  MSSQL: {
    name: 'MS SQL',
    class: 'bg-black text-white',
    icon: MSSQLIcon,
  },
};
const PROJECTS = [
  {
    title: 'Ukiyo Designs',
    eyebrow: 'Proyecto destacado · solución real para e-commerce',
    description:
      'Sistema ASP.NET Core MVC para un emprendimiento familiar que fabrica mochilas, bolsos e indumentaria. Reemplaza un Excel de costos que había creado previamente y centraliza tienda, productos, usuarios, roles, órdenes, favoritos y cálculo de precios.',
    stack: [
      'ASP.NET Core 8 MVC',
      'Entity Framework Core',
      'SQL Server',
      'Identity + Facebook OAuth',
      'Stripe',
      'ES/EN localization',
    ],
    highlights: [
      'Calculadora administrativa con telas, herrajes, packaging, costos fijos, costos porcentuales y márgenes de ganancia.',
      'Dashboard de precios finales con comparación entre precios actuales, costos calculados, márgenes, filtros y exportación.',
      'Soporte multi-compañía, Identity, Facebook OAuth, Stripe, localización ES/EN y SQL views/triggers para cálculos.',
    ],
    link: 'https://ukiyo.bsite.net/',
    github: 'https://github.com/Emmanuel-Valdez/Ukiyo',
    image: '/projects/ukiyo/store-home.jpg',
    imageAlt: 'Captura real de la tienda virtual Ukiyo Designs con catálogo de productos',
    tags: [TAGS.CSharp, TAGS.GitHub, TAGS.MSSQL],
  },
  {
    title: 'Proyecto final C# QUARK Academy',
    description:
      'Calculadora de costos para tienda de ropa creada en C# con Windows Forms. Incluye historial de cotización, restricciones de stock y manejo de errores.',
    link: '',
    github: 'https://github.com/Emmanuel-Valdez/ProyectoCQuarq',
    image: '/projects/CotizadorTiendaRopa.webp',
    imageAlt: 'Captura de la calculadora de costos para tienda de ropa en C#',
    tags: [TAGS.CSharp, TAGS.GitHub],
  },
  {
    title: 'Funko shop',
    description:
      'Tienda virtual de funkos creada con Node.js, Express y MySQL. Incluye operaciones CRUD, carrito de compras, paginación y autenticación.',
    link: 'https://fullstackproject-backend.vercel.app/',
    github: 'https://github.com/Emmanuel-Valdez/fullstackproject-backend',
    image: '/projects/funko_shopWeb.webp',
    imageAlt: 'Captura de la tienda virtual Funko shop',
    tags: [TAGS.NodeJS, TAGS.Express, TAGS.MySQL, TAGS.GitHub],
  },
];

const [FEATURED_PROJECT, ...SUPPORTING_PROJECTS] = PROJECTS;
const FEATURED_STACK = FEATURED_PROJECT.stack ?? [];
const FEATURED_HIGHLIGHTS = FEATURED_PROJECT.highlights ?? [];
---

<div class="flex flex-col gap-y-12">
  <article class="group relative overflow-hidden rounded-3xl border border-sky-300/20 bg-slate-950/80 shadow-2xl shadow-sky-950/30">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-sky-300/80 to-transparent" aria-hidden="true"></div>
    <div class="grid gap-8 p-5 md:grid-cols-[1.05fr_0.95fr] md:p-7 lg:p-8">
      <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black/30">
        <img
          alt={FEATURED_PROJECT.imageAlt}
          class="h-full min-h-72 w-full object-cover object-top transition duration-500 md:group-hover:scale-[1.03]"
          loading="lazy"
          src={FEATURED_PROJECT.image}
        />
      </div>

      <div class="flex flex-col justify-center">
        <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-sky-200/80">
          {FEATURED_PROJECT.eyebrow}
        </p>
        <h3 class="text-3xl font-bold text-white md:text-4xl">
          {FEATURED_PROJECT.title}
        </h3>
        <p class="mt-4 text-pretty text-gray-300">
          {FEATURED_PROJECT.description}
        </p>

        <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Stack técnico de ${FEATURED_PROJECT.title}`}>
          {FEATURED_STACK.map((item) => (
            <li class="rounded-full border border-sky-300/20 bg-sky-300/10 px-2.5 py-1 text-xs font-medium text-sky-100">
              {item}
            </li>
          ))}
        </ul>

        <ul class="mt-5 space-y-3 text-sm text-gray-200">
          {FEATURED_HIGHLIGHTS.map((highlight) => (
            <li class="flex gap-x-3">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true" />
              <span>{highlight}</span>
            </li>
          ))}
        </ul>

        <footer class="mt-6 flex flex-wrap items-center gap-4">
          {FEATURED_PROJECT.github && (
            <LinkButton href={FEATURED_PROJECT.github}>
              <GitHubIcon class="size-5" />
              Code
            </LinkButton>
          )}
          {FEATURED_PROJECT.link && (
            <LinkButton href={FEATURED_PROJECT.link}>
              <WebIcon class="size-5" />
              Preview
            </LinkButton>
          )}
          <LinkButton href="/proyectos/ukiyo/">
            Ver caso de estudio
          </LinkButton>
        </footer>
      </div>
    </div>
  </article>

  <div>
    <p class="mb-6 text-sm font-medium uppercase tracking-[0.2em] text-gray-400">
      Proyectos de soporte
    </p>
    <div class="grid gap-6 md:grid-cols-2">
      {
        SUPPORTING_PROJECTS.map(({ image, imageAlt, title, description, tags, link, github }) => (
          <article class="group overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] transition duration-300 hover:border-sky-300/30 hover:bg-white/[0.06]">
            <div class="overflow-hidden border-b border-white/10">
              <img
                alt={imageAlt}
                class="h-48 w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                src={image}
              />
            </div>

            <div class="p-5">
              <h3 class="text-xl font-bold text-gray-100">{title}</h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li>
                    <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} px-2 py-1`}>
                      <tag.icon class="size-4" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>

              <p class="mt-4 text-sm text-gray-400">{description}</p>
              <footer class="mt-5 flex flex-wrap items-center gap-3">
                {github && (
                  <LinkButton href={github}>
                    <GitHubIcon class="size-5" />
                    Code
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link}>
                    <WebIcon class="size-5" />
                    Preview
                  </LinkButton>
                )}
              </footer>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</div>
