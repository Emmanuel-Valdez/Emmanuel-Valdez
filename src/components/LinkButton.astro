---
const {
  href,
  class: className,
  target,
  rel,
  ...rest
} = Astro.props;

const isExternalLink = typeof href === 'string' && /^https?:\/\//.test(href);
const finalTarget = target ?? (isExternalLink ? '_blank' : undefined);
const finalRel = rel ?? (finalTarget === '_blank' ? 'noopener noreferrer' : undefined);
---

<a
  {...rest}
  href={href}
  class={`inline-flex min-h-11 items-center gap-x-1 rounded-lg border border-line-strong bg-surface-2 px-4 py-2 text-sm font-medium text-body transition hover:bg-elevated hover:text-ink focus:z-10 focus:outline-none focus:ring-4 focus:ring-accent-ring ${className ?? ''}`}
  target={finalTarget}
  rel={finalRel}
>
  <slot />
</a>
