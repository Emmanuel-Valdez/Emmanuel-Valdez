---
import Layout from '@/layouts/Layout.astro';
import Experience from '@/components/Experience.astro';
import SectionContainer from '@/components/SectionContainer.astro';
import CodeIcon from '@/icons/Code.astro';
import Projects from '@/components/Projects.astro';
import BriefCaseIcon from '@/icons/BriefCaseIcon.astro';
import UserIcon from '@/icons/User.astro';
import CoffeeIcon from '@/icons/Coffee.astro';
import AboutMe from '@/components/AboutMe.astro';
import Contact from '@/components/Contact.astro';
import Hero from '@/components/Hero.astro';
import type { Locale } from '@/data/i18n';

interface Props {
  content: typeof import('@/data/i18n').homeContent[Locale];
  locale: Locale;
  alternatePath: string;
}

// ponytail: build-time date, no CI changes needed (SSG prerenders on deploy)
const buildDate = new Date().toISOString().slice(0, 10);
const { content, locale, alternatePath } = Astro.props;
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  locale={locale}
  alternatePath={alternatePath}
>
  <main id="main-content" class="px-4">
    <SectionContainer class="py-20 pb-32">
      <Hero content={content.hero} />
    </SectionContainer>

    <SectionContainer id="proof">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-accent sm:text-sm sm:tracking-[0.24em]">{content.proofOfWork.eyebrow}</p>
      <h2 class="mt-3 text-2xl font-bold text-ink sm:text-3xl">{content.proofOfWork.title}</h2>
      <p class="mt-3 text-sm leading-6 text-muted sm:text-base sm:leading-7">{content.proofOfWork.description}</p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {content.proofOfWork.items.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-w-0 items-center justify-between gap-3 rounded-2xl border border-line bg-surface p-4 transition hover:border-accent-line hover:bg-surface-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <div class="min-w-0">
              <p class="text-xs font-medium text-subtle">{item.label}</p>
              <p class="mt-1 truncate text-sm font-semibold text-ink">{item.value}</p>
            </div>
            <span class="shrink-0 text-accent transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <p class="mt-4 text-xs text-subtle">
        <a
          class="underline decoration-dotted underline-offset-2 hover:text-body"
          href={content.proofOfWork.docsHref}
          target="_blank"
          rel="noopener noreferrer">{content.proofOfWork.docsLabel}</a>
        · {content.proofOfWork.updatedLabel} {buildDate} · <a
          class="underline decoration-dotted underline-offset-2 hover:text-body"
          href="https://vaultshop.evaldez.ar/health/live"
          target="_blank"
          rel="noopener noreferrer">health/live</a
        >
        <span id="vs-health" aria-live="polite" data-ok={content.proofOfWork.statusOk} data-fail={content.proofOfWork.statusFail}>○</span>
      </p>
      <script is:inline>
        fetch('https://vaultshop.evaldez.ar/health/live').then(function (r) { return r.json(); }).then(function (j) {
          var el = document.getElementById('vs-health');
          if (!el) return;
          var ok = j && j.status === 'Healthy';
          el.textContent = '● ' + (ok ? el.dataset.ok : el.dataset.fail);
          el.style.color = ok ? 'var(--color-success)' : 'var(--color-danger)';
        }).catch(function () { var el = document.getElementById('vs-health'); if (el) el.textContent = ''; });
      </script>
    </SectionContainer>

    <SectionContainer id="projects">
      <h2 class="mb-6 flex items-center gap-x-3 text-3xl font-semibold">
        <CodeIcon class="size-7" />
        {content.sections.projects}
      </h2>
      <Projects content={content.projects} />
    </SectionContainer>

    <SectionContainer id="experience">
      <h2 class="mb-6 flex items-center gap-x-3 text-3xl font-semibold">
        <BriefCaseIcon class="size-7" />
        {content.sections.experience}
      </h2>
      <Experience items={content.experience} />
    </SectionContainer>

    <SectionContainer id="about">
      <h2 class="mb-6 flex items-center gap-x-3 text-3xl font-semibold">
        <UserIcon class="size-7" />
        {content.sections.about}
      </h2>
      <AboutMe content={content.about} />
    </SectionContainer>

    <SectionContainer id="contact">
      <h2 class="mb-6 flex items-center gap-x-3 text-3xl font-semibold">
        <CoffeeIcon class="size-7" />
        {content.sections.contact}
      </h2>
      <Contact content={content.contact} />
    </SectionContainer>
  </main>
</Layout>
