---
import { common, routes, type Locale } from '@/data/i18n';

interface Props {
  locale?: Locale;
}

const currentYear = new Date().getFullYear();
const { locale = 'es' } = Astro.props;
const copy = common[locale];
const homeHref = routes[locale].home;
---

<footer
  class="opacity-80 m-4 mt-16 bg-black/20 backdrop-blur-lg w-full md:max-w-2xl mx-auto container lg:max-w-4xl justify-center"
>
  <div
    class="rounded-lg w-full max-w-screen-xl p-4 mx-auto flex items-center justify-between py-4"
  >
    <span class="text-sm sm:text-center text-zinc-200/90"
      >© {currentYear} <a href={homeHref} class="hover:underline">{copy.footer.brand}</a>
    </span>
    <ul
      class="flex flex-wrap items-center text-sm font-medium text-zinc-200/90 sm:mt-0"
    >
      <li>
        <a href={`${homeHref}#about`} class="hover:underline me-4 md:me-6">{copy.footer.about}</a>
      </li>
      <li>
        <a href={`${homeHref}#contact`} class="hover:underline">{copy.footer.contact}</a>
      </li>
    </ul>
  </div>
</footer>
