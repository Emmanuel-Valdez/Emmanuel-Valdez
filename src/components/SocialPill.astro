---
const { href, target, rel, ...rest } = Astro.props;

const isExternalLink = typeof href === 'string' && /^https?:\/\//.test(href);
const finalTarget = target ?? (isExternalLink ? '_blank' : undefined);
const finalRel = rel ?? (finalTarget === '_blank' ? 'noopener noreferrer' : undefined);
---

<a
  class="rounded-full border border-white/20 flex justify-center items-center gap-x-2
  py-1 px-2 md:py-2 md:px-4
  text-xs md:text-base
  bg-white/5
  hover:scale-110 hover:bg-white/10 transition focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-700 focus:text-blue-700"
  {...rest}
  href={href}
  target={finalTarget}
  rel={finalRel}
>
  <slot />
</a>
