---
const { href, target, rel, ...rest } = Astro.props;

const isExternalLink = typeof href === 'string' && /^https?:\/\//.test(href);
const finalTarget = target ?? (isExternalLink ? '_blank' : undefined);
const finalRel = rel ?? (finalTarget === '_blank' ? 'noopener noreferrer' : undefined);
---

<a
  class="flex min-h-11 items-center justify-center gap-x-2 rounded-full border border-white/20
  px-3 py-2 md:px-4
  text-xs md:text-base
  bg-white/5
  transition hover:scale-110 hover:bg-white/10 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-700"
  {...rest}
  href={href}
  target={finalTarget}
  rel={finalRel}
>
  <slot />
</a>
