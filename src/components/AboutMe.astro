---
interface Props {
  content: {
    focusAreas: readonly {
      title: string;
      description: string;
    }[];
    intro: string;
    strong: string;
    paragraphs: readonly string[];
    closing: string;
    imageAlt: string;
  };
}

const { content } = Astro.props;
const [introBeforeStrong, introAfterStrong] = content.intro.split(content.strong);
---

<section class="grid gap-8 md:grid-cols-[1fr_auto] md:items-start">
  <div class="order-2 md:order-1">
    <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:p-6">
      <p class="text-pretty text-lg font-semibold leading-8 text-white">
        {introBeforeStrong} <strong class="text-yellow-300">{content.strong}</strong>{introAfterStrong}
      </p>

      <div class="mt-5 space-y-4 text-pretty text-sm leading-7 text-gray-300 sm:text-base">
        {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      {content.focusAreas.map((area) => (
        <article class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
          <h3 class="text-sm font-bold text-white">{area.title}</h3>
          <p class="mt-2 text-sm leading-6 text-gray-400">{area.description}</p>
        </article>
      ))}
    </div>

    <p class="mt-5 text-pretty text-sm leading-7 text-gray-400 sm:text-base">
      {content.closing}
    </p>
  </div>

  <div class="order-1 mx-auto md:order-2 md:mx-0">
    <div class="rounded-full border border-sky-300/20 bg-sky-300/10 p-2 shadow-2xl shadow-sky-950/30">
      <img
        src="/Emma.png"
        class="size-44 rounded-full object-cover object-center sm:size-56 md:size-64"
        alt={content.imageAlt}
      />
    </div>
  </div>
</section>
