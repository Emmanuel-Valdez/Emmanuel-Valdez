---
interface Props {
  content: {
    focusAreas: readonly {
      title: string;
      description: string;
    }[];
    intro: string;
    strong: string;
    paragraphs: readonly string[];
    closing: string;
    imageAlt: string;
  };
}

const { content } = Astro.props;
---

<section class="grid gap-8 md:grid-cols-[1fr_auto] md:items-start">
  <div class="order-2 md:order-1">
    <div class="rounded-3xl border border-line bg-surface p-5 sm:p-6">
      <p class="text-pretty text-lg font-semibold leading-8 text-ink">
        {content.intro} <strong class="text-accent">{content.strong}</strong>
      </p>

      <div class="mt-5 space-y-4 text-pretty text-sm leading-7 text-body sm:text-base">
        {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      {content.focusAreas.map((area) => (
        <article class="rounded-2xl border border-line bg-panel p-4">
          <h3 class="text-sm font-bold text-ink">{area.title}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{area.description}</p>
        </article>
      ))}
    </div>

    <p class="mt-5 text-pretty text-sm leading-7 text-muted sm:text-base">
      {content.closing}
    </p>
  </div>

  <div class="order-1 mx-auto md:order-2 md:mx-0">
    <div class="rounded-full border border-line bg-accent-soft p-2 shadow-2xl shadow-umbra/30">
      <img
        src="/Emma.png"
        class="size-44 rounded-full object-cover object-center sm:size-56 md:size-64"
        alt={content.imageAlt}
      />
    </div>
  </div>
</section>
