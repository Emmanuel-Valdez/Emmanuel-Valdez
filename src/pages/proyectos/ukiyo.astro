---
import Layout from '@/layouts/Layout.astro';
import LinkButton from '@/components/LinkButton.astro';
import GitHubIcon from '@/icons/techIcons/GitHub.astro';
import WebIcon from '@/icons/Web.astro';
import { routes, type Locale, ukiyoContent } from '@/data/i18n';

const locale = (Astro.props.locale ?? 'es') as Locale;
const content = ukiyoContent[locale];
const alternatePath = locale === 'es' ? routes.en.ukiyo : routes.es.ukiyo;
const stack = content.backend.stack;
const metrics = content.metrics;
const demoScope = content.demoScope;
const problemItems = content.problemItems;
const solutionItems = content.solutionItems;
const architectureFlows = content.architecture.flows;
const stackLayers = content.stackLayers.items;
const calculationInputs = content.calculator.inputs;
const finalPriceFeatures = content.calculator.finalFeatures;
const backendHighlights = content.backend.highlights;
const dataModelGroups = content.dataModel.groups;
const readinessItems = content.impact.items;
const screenshots = content.media.screenshots;
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  image={content.meta.image}
  locale={locale}
  alternatePath={alternatePath}
>
  <main id="main-content" class="px-4 pt-20 sm:px-6 sm:pt-28">
    <article class="mx-auto w-full max-w-5xl pb-14 md:pb-24">
      <a href={content.backHref} class="text-sm font-medium text-sky-200 transition hover:text-white">
        {content.backLabel}
      </a>

      <header class="relative mt-6 overflow-hidden rounded-3xl border border-sky-300/20 bg-slate-950/80 p-4 shadow-2xl shadow-sky-950/30 sm:mt-8 sm:p-6 md:rounded-[2rem] md:p-10">
        <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-sky-300 to-transparent" aria-hidden="true"></div>
        <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.26em]">
              {content.eyebrow}
            </p>
            <h1 class="mt-3 text-balance text-3xl font-black tracking-tight text-white sm:mt-4 sm:text-4xl md:text-6xl">
              {content.title}
            </h1>
            <p class="mt-4 max-w-2xl text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-lg sm:leading-8">
              {content.intro}
            </p>

            <div class="mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap">
              <LinkButton href="https://ukiyo.bsite.net/" class="justify-center sm:justify-start">
                <WebIcon class="size-5" />
                {content.buttons.demo}
              </LinkButton>
              <LinkButton href="https://github.com/Emmanuel-Valdez/Ukiyo" class="justify-center sm:justify-start">
                <GitHubIcon class="size-5" />
                {content.buttons.code}
              </LinkButton>
            </div>
          </div>

          <div class="overflow-hidden rounded-2xl border border-white/10 bg-black/30">
            <img
              src="/projects/ukiyo/store-home.jpg"
              alt={content.heroImageAlt}
              class="h-full min-h-48 w-full object-cover object-top sm:min-h-72"
            />
          </div>
        </div>
      </header>

      <section class="mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-3" aria-label={content.metricsAriaLabel}>
        {metrics.map((metric) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 sm:p-5">
            <p class="text-sm text-gray-400">{metric.label}</p>
            <p class="mt-2 text-lg font-bold text-white sm:text-xl">{metric.value}</p>
          </div>
        ))}
      </section>

      <section class="relative mt-8 overflow-hidden rounded-3xl border border-emerald-300/20 bg-slate-950/70 p-5 shadow-2xl shadow-emerald-950/10 sm:mt-10 sm:p-6 md:p-8">
        <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-emerald-300/80 to-transparent" aria-hidden="true"></div>
        <div class="absolute -right-20 -top-24 size-56 rounded-full bg-emerald-300/10 blur-3xl" aria-hidden="true"></div>

        <div class="relative grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-emerald-200/80 sm:text-sm sm:tracking-[0.24em]">
              {demoScope.eyebrow}
            </p>
            <h2 class="mt-3 text-balance text-2xl font-bold text-white sm:text-3xl">
              {demoScope.title}
            </h2>
            <p class="mt-4 text-pretty text-sm leading-7 text-gray-300 sm:text-base">
              {demoScope.description}
            </p>
          </div>

          <div class="grid gap-3 sm:gap-4">
            <article class="rounded-2xl border border-emerald-300/20 bg-emerald-300/[0.08] p-4 sm:p-5">
              <h3 class="text-lg font-bold text-emerald-50">{demoScope.publicTitle}</h3>
              <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-300">
                {demoScope.publicItems.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-emerald-300" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>

            <div class="grid gap-3 sm:gap-4 md:grid-cols-2">
              <article class="rounded-2xl border border-amber-300/20 bg-amber-300/[0.07] p-4 sm:p-5">
                <h3 class="text-lg font-bold text-amber-50">{demoScope.protectedTitle}</h3>
                <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-300">
                  {demoScope.protectedItems.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-amber-300" aria-hidden="true"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>

              <article class="rounded-2xl border border-sky-300/20 bg-sky-300/[0.07] p-4 sm:p-5">
                <h3 class="text-lg font-bold text-sky-50">{demoScope.evidenceTitle}</h3>
                <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-300">
                  {demoScope.evidenceItems.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section class="mt-10 grid gap-5 sm:mt-14 sm:gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.context.eyebrow}</p>
          <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.context.title}</h2>
        </div>
        <div class="space-y-4 text-pretty text-sm leading-7 text-gray-300 sm:space-y-5 sm:text-base">
          {content.context.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="mt-10 grid gap-4 sm:mt-14 sm:gap-6 md:grid-cols-2">
        <div class="rounded-3xl border border-red-300/10 bg-red-950/10 p-5 sm:p-6">
          <h2 class="text-2xl font-bold text-white">{content.problemTitle}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-300 sm:mt-5 sm:space-y-4 sm:text-base">
            {problemItems.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-red-300" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-3xl border border-sky-300/20 bg-sky-950/20 p-5 sm:p-6">
          <h2 class="text-2xl font-bold text-white">{content.solutionTitle}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-300 sm:mt-5 sm:space-y-4 sm:text-base">
            {solutionItems.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="mt-10 rounded-3xl border border-sky-300/20 bg-slate-950/70 p-5 sm:mt-14 sm:p-6 md:p-8">
        <div class="grid gap-6 sm:gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.architecture.eyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.architecture.title}</h2>
            <p class="mt-4 text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-base">
              {content.architecture.description}
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/30 p-4 sm:p-5">
            <ol class="space-y-3 sm:space-y-4" aria-label={content.architecture.flowAriaLabel}>
              {content.architecture.steps.map((step, index) => (
                <li class="flex gap-4">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-sky-300/30 bg-sky-300/10 text-sm font-bold text-sky-100">{index + 1}</span>
                  <div>
                    <h3 class="font-bold text-white">{step.title}</h3>
                    <p class="mt-1 text-sm leading-6 text-gray-400">{step.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="mt-6 rounded-3xl border border-white/10 bg-black/20 p-4 sm:mt-8 sm:p-5 md:p-6">
          <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
              <h3 class="text-xl font-bold text-white sm:text-2xl">{content.architecture.diagram.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-400">
                {content.architecture.diagram.description}
              </p>
            </div>
          </div>

          <div class="mt-6 grid gap-3 md:grid-cols-[0.9fr_auto_1.15fr_auto_0.9fr] md:items-center">
            <article class="rounded-2xl border border-sky-300/20 bg-sky-300/10 p-4 text-center">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-100">{content.architecture.diagram.browser}</p>
              <div class="mt-4 grid grid-cols-2 gap-2 text-xs text-sky-50/90">
                {content.architecture.diagram.browserDetails.map((item) => (
                  <span class="rounded-full border border-sky-200/20 bg-sky-950/60 px-3 py-1.5">{item}</span>
                ))}
              </div>
            </article>

            <div class="hidden text-2xl font-bold text-sky-200 md:block" aria-hidden="true">→</div>

            <article class="rounded-2xl border border-yellow-300/20 bg-yellow-300/10 p-4">
              <p class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-yellow-100">{content.architecture.diagram.app}</p>
              <ul class="mt-4 grid gap-2 text-sm text-gray-200 sm:grid-cols-2">
                {content.architecture.diagram.appDetails.map((item) => (
                  <li class="rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2 text-center">{item}</li>
                ))}
              </ul>
            </article>

            <div class="hidden text-2xl font-bold text-sky-200 md:block" aria-hidden="true">→</div>

            <article class="rounded-2xl border border-emerald-300/20 bg-emerald-300/10 p-4">
              <p class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-emerald-100">{content.architecture.diagram.data}</p>
              <ul class="mt-4 grid gap-2 text-sm text-gray-200">
                {content.architecture.diagram.dataDetails.map((item) => (
                  <li class="rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2 text-center">{item}</li>
                ))}
              </ul>
            </article>
          </div>

          <div class="mt-3 grid gap-3 md:grid-cols-[0.9fr_auto_1.15fr_auto_0.9fr] md:items-center">
            <div class="hidden md:block" aria-hidden="true"></div>
            <div class="hidden md:block" aria-hidden="true"></div>
            <article class="rounded-2xl border border-violet-300/20 bg-violet-300/10 p-4">
              <p class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-violet-100">{content.architecture.diagram.services}</p>
              <ul class="mt-4 grid gap-2 text-sm text-gray-200 sm:grid-cols-2">
                {content.architecture.diagram.serviceDetails.map((item) => (
                  <li class="rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2 text-center">{item}</li>
                ))}
              </ul>
            </article>
            <div class="hidden md:block" aria-hidden="true"></div>
            <div class="hidden md:block" aria-hidden="true"></div>
          </div>
        </div>

        <div class="mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-3">
          {architectureFlows.map((flow) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 sm:p-5">
              <h3 class="text-lg font-bold text-white">{flow.title}</h3>
              <p class="mt-3 text-sm leading-6 text-gray-400">{flow.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-6 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-8 sm:p-6 md:p-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.stackLayers.eyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.stackLayers.title}</h2>
          </div>
          <p class="max-w-sm text-sm leading-6 text-gray-400">
            {content.stackLayers.description}
          </p>
        </div>

        <div class="mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-2 lg:grid-cols-4">
          {stackLayers.map((layer) => (
            <article class="rounded-2xl border border-white/10 bg-slate-950/70 p-4 sm:p-5">
              <h3 class="text-lg font-bold text-white">{layer.layer}</h3>
              <ul class="mt-4 space-y-3 text-sm text-gray-300">
                {layer.items.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-10 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-14 sm:p-6 md:p-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.calculator.eyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.calculator.title}</h2>
          </div>
          <p class="max-w-sm text-sm text-gray-400">
            {content.calculator.description}
          </p>
        </div>

        <div class="mt-6 grid gap-3 sm:mt-8 md:grid-cols-2">
          {calculationInputs.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4 text-sm text-gray-300">
              {item}
            </div>
          ))}
        </div>

        <div class="mt-6 rounded-2xl border border-sky-300/20 bg-sky-950/20 p-4 sm:mt-8 sm:p-5">
          <h3 class="text-xl font-bold text-white">{content.calculator.finalTitle}</h3>
          <p class="mt-3 text-pretty text-sm leading-6 text-gray-300">
            {content.calculator.finalDescription}
          </p>
          <ul class="mt-5 grid gap-3 text-sm text-gray-300 md:grid-cols-2">
            {finalPriceFeatures.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="mt-10 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-14 sm:p-6 md:p-8">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.dataModel.eyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.dataModel.title}</h2>
          </div>
          <p class="max-w-sm text-sm leading-6 text-gray-400">
            {content.dataModel.description}
          </p>
        </div>

        <div class="mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-2 lg:grid-cols-4">
          {dataModelGroups.map((group) => (
            <article class="rounded-2xl border border-white/10 bg-slate-950/70 p-4 sm:p-5">
              <h3 class="text-lg font-bold text-white">{group.title}</h3>
              <ul class="mt-4 space-y-2 text-sm text-gray-300">
                {group.items.map((item) => (
                  <li class="overflow-hidden break-words rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 font-mono text-[0.7rem] text-gray-300 sm:text-xs">
                    {item}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-10 grid gap-4 sm:mt-14 sm:gap-8 lg:grid-cols-[1fr_0.9fr]">
        <div class="rounded-3xl border border-white/10 bg-slate-950/70 p-5 sm:p-6 md:p-8">
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.backend.eyebrow}</p>
          <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.backend.title}</h2>
          <ul class="mt-5 space-y-3 text-sm leading-6 text-gray-300 sm:mt-6 sm:space-y-4 sm:text-base">
            {backendHighlights.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <aside class="rounded-3xl border border-sky-300/20 bg-gradient-to-b from-sky-950/40 to-slate-950 p-5 sm:p-6 md:p-8">
          <h2 class="text-2xl font-bold text-white">{content.backend.stackTitle}</h2>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={content.backend.stackAriaLabel}>
            {stack.map((item) => (
              <li class="rounded-full border border-sky-300/20 bg-sky-300/10 px-3 py-1.5 text-xs font-medium text-sky-100 sm:text-sm">
                {item}
              </li>
            ))}
          </ul>
        </aside>
      </section>

      <section class="mt-10 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-14 sm:p-6 md:p-8">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.impact.eyebrow}</p>
        <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.impact.title}</h2>
        <p class="mt-4 max-w-3xl text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-base">
          {content.impact.description}
        </p>
        <ul class="mt-5 grid gap-3 text-sm leading-6 text-gray-300 sm:mt-6 md:grid-cols-2">
          {readinessItems.map((item) => (
            <li class="flex gap-3 rounded-2xl border border-white/10 bg-slate-950/70 p-4">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-10 sm:mt-14">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.media.eyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.media.title}</h2>
          </div>
          <p class="max-w-md text-sm leading-6 text-gray-400">
            {content.media.description}
          </p>
        </div>

        <div class="mt-6 grid gap-4 sm:mt-8 sm:gap-6 md:grid-cols-2">
          {screenshots.map((screenshot) => (
            <figure class="overflow-hidden rounded-3xl border border-white/10 bg-slate-950/80 shadow-xl shadow-black/20">
              <img
                src={screenshot.src}
                alt={screenshot.alt}
                loading="lazy"
                class="aspect-[4/3] w-full object-cover object-top sm:aspect-[16/10]"
              />
              <figcaption class="border-t border-white/10 p-4 sm:p-5">
                <h3 class="text-lg font-bold text-white">{screenshot.title}</h3>
                <p class="mt-2 text-sm leading-6 text-gray-400">{screenshot.description}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    </article>
  </main>
</Layout>
