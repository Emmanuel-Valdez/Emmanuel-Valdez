---
import Layout from '@/layouts/Layout.astro';
import LinkButton from '@/components/LinkButton.astro';
import GitHubIcon from '@/icons/techIcons/GitHub.astro';
import WebIcon from '@/icons/Web.astro';
import { routes, type Locale, vaultshopContent } from '@/data/i18n';

const locale = (Astro.props.locale ?? 'es') as Locale;
const content = vaultshopContent[locale];
const alternatePath = locale === 'es' ? routes.en.vaultshop : routes.es.vaultshop;
const stack = content.backend.stack;
const whatBuiltItems = content.whatBuilt.items;
const demoScope = content.demoScope;
const problemItems = content.problemItems;
const solutionItems = content.solutionItems;
const stackLayers = content.stackLayers.items;
const calculationInputs = content.calculator.inputs;
const finalPriceFeatures = content.calculator.finalFeatures;
const calculatorProofItems = content.calculator.proofItems;
const backendHighlights = content.backend.highlights;
const backendDecisions = content.backend.decisions;
const dataModelGroups = content.dataModel.groups;
const dataModelDiagram = content.dataModel.diagram;
const lessonsItems = content.lessonsLearned.items;
const infraItems = content.infrastructure.items;
const operationalItems = content.operationalProof.items;
const limitationItems = content.limitations.items;
const screenshots = content.media.screenshots;
const pricingScreenshot = screenshots[4];
const mediaGroups = content.media.groups.map((group) => ({
  ...group,
  screenshots: group.screenshotIndexes.map((index) => screenshots[index]),
}));
const walkthroughHighlights = content.walkthrough.highlights;
const walkthroughVideoSrc = locale === 'es' ? '/videos/ukiyo-walkthrough-es.mp4' : '/videos/ukiyo-walkthrough.mp4';
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  image={content.meta.image}
  locale={locale}
  alternatePath={alternatePath}
>
  <main id="main-content" class="px-4 pt-20 sm:px-6 sm:pt-28">
    <article class="mx-auto w-full max-w-5xl pb-14 md:pb-24">
      <a href={content.backHref} class="text-sm font-medium text-sky-200 transition hover:text-white">
        {content.backLabel}
      </a>

      <header class="relative mt-6 overflow-hidden rounded-3xl border border-sky-300/20 bg-slate-950/80 p-4 shadow-2xl shadow-sky-950/30 sm:mt-8 sm:p-6 md:rounded-[2rem] md:p-10">
        <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-sky-300 to-transparent" aria-hidden="true"></div>
        <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.26em]">
              {content.eyebrow}
            </p>
            <h1 class="mt-3 text-balance text-3xl font-black tracking-tight text-white sm:mt-4 sm:text-4xl md:text-6xl">
              {content.title}
            </h1>
            <p class="mt-4 max-w-2xl text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-lg sm:leading-8">
              {content.intro}
            </p>

            <div class="mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap">
              <LinkButton href="https://vaultshop.evaldez.ar/" class="justify-center sm:justify-start">
                <WebIcon class="size-5" />
                {content.buttons.demo}
              </LinkButton>
              <LinkButton href="https://github.com/Emmanuel-Valdez/VaultShop" class="justify-center sm:justify-start">
                <GitHubIcon class="size-5" />
                {content.buttons.code}
              </LinkButton>
            </div>
          </div>

          <div class="overflow-hidden rounded-2xl border border-white/10 bg-black/30">
            <img
              src="/projects/vaultshop/storefront.webp"
              alt={content.heroImageAlt}
              class="h-full min-h-48 w-full object-cover object-top sm:min-h-72"
            />
          </div>
        </div>
      </header>

      <section class="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-10 sm:p-6 md:p-8">
        <div class="grid gap-5 sm:gap-8 lg:grid-cols-[0.9fr_1.1fr]">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.context.eyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.context.title}</h2>
          </div>
          <div class="space-y-4 text-pretty text-sm leading-7 text-gray-300 sm:space-y-5 sm:text-base">
            {content.context.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <div class="mt-6 grid gap-4 sm:mt-8 sm:gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-red-300/10 bg-red-950/10 p-4 sm:p-5">
            <h3 class="text-xl font-bold text-white">{content.problemTitle}</h3>
            <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-300">
              {problemItems.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-red-300" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-sky-300/20 bg-sky-950/20 p-4 sm:p-5">
            <h3 class="text-xl font-bold text-white">{content.solutionTitle}</h3>
            <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-300">
              {solutionItems.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="mt-8 rounded-3xl border border-sky-300/20 bg-slate-950/70 p-5 sm:mt-10 sm:p-6 md:p-8" aria-labelledby="ukiyo-built-title">
        <div class="grid gap-5 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">
              {content.whatBuilt.eyebrow}
            </p>
            <h2 id="ukiyo-built-title" class="mt-3 text-balance text-2xl font-bold text-white sm:text-3xl">
              {content.whatBuilt.title}
            </h2>
            <p class="mt-4 text-pretty text-sm leading-7 text-gray-300 sm:text-base">
              {content.whatBuilt.description}
            </p>
          </div>

          <ul class="grid gap-3 text-sm leading-6 text-gray-300 sm:grid-cols-2">
            {whatBuiltItems.map((item) => (
              <li class="flex gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-4">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 rounded-2xl border border-emerald-300/20 bg-emerald-300/[0.07] p-4 sm:p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-200/80">{demoScope.eyebrow}</p>
          <h3 class="mt-2 text-lg font-bold text-white">{demoScope.title}</h3>
          <p class="mt-2 text-sm leading-6 text-gray-300">{demoScope.description}</p>
          <div class="mt-4 grid gap-4 text-sm leading-6 text-gray-300 md:grid-cols-3">
            <div>
              <h4 class="font-bold text-emerald-50">{demoScope.publicTitle}</h4>
              <ul class="mt-2 space-y-2">
                {demoScope.publicItems.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-amber-50">{demoScope.protectedTitle}</h4>
              <ul class="mt-2 space-y-2">
                {demoScope.protectedItems.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h4 class="font-bold text-sky-50">{demoScope.evidenceTitle}</h4>
              <ul class="mt-2 space-y-2">
                {demoScope.evidenceItems.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="relative mt-8 overflow-hidden rounded-3xl border border-sky-300/20 bg-slate-950/75 p-4 shadow-2xl shadow-sky-950/20 sm:mt-10 sm:p-6 md:p-8" aria-labelledby="ukiyo-walkthrough-title">
        <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-sky-300/80 to-transparent" aria-hidden="true"></div>
        <div class="absolute -left-24 -top-24 size-64 rounded-full bg-sky-300/10 blur-3xl" aria-hidden="true"></div>

        <div class="relative grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <figure class="overflow-hidden rounded-2xl border border-white/10 bg-black/40 shadow-xl shadow-black/30">
            <video
              class="aspect-video w-full bg-black object-cover"
              controls
              preload="metadata"
              poster="/projects/vaultshop/storefront.webp"
              aria-label={content.walkthrough.videoLabel}
            >
              <source src={walkthroughVideoSrc} type="video/mp4" />
              {content.walkthrough.fallback}
            </video>
            <figcaption class="border-t border-white/10 bg-slate-950/80 p-3 sm:p-4">
              <details class="group">
                <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-2 text-sm font-semibold text-sky-100 marker:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300">
                  <span>{content.walkthrough.transcriptLabel}</span>
                  <span class="text-lg leading-none text-sky-200 transition group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <ul class="mt-3 space-y-2 px-2 text-sm leading-6 text-gray-300">
                  {content.walkthrough.transcriptItems.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </details>
            </figcaption>
          </figure>

          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">
              {content.walkthrough.eyebrow}
            </p>
            <h2 id="ukiyo-walkthrough-title" class="mt-3 text-balance text-2xl font-bold text-white sm:text-3xl">
              {content.walkthrough.title}
            </h2>
            <p class="mt-4 text-pretty text-sm leading-7 text-gray-300 sm:text-base">
              {content.walkthrough.description}
            </p>
            <ul class="mt-5 grid gap-3 text-sm leading-6 text-gray-300">
              {walkthroughHighlights.map((item) => (
                <li class="flex gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-3">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="mt-10 rounded-3xl border border-sky-300/20 bg-slate-950/70 p-5 sm:mt-14 sm:p-6 md:p-8">
        <div class="grid gap-6 sm:gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.architecture.eyebrow}</p>
            <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.architecture.title}</h2>
            <p class="mt-4 text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-base">
              {content.architecture.description}
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/30 p-4 sm:p-5">
            <ol class="space-y-3 sm:space-y-4" aria-label={content.architecture.flowAriaLabel}>
              {content.architecture.steps.map((step, index) => (
                <li class="flex gap-4">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-sky-300/30 bg-sky-300/10 text-sm font-bold text-sky-100">{index + 1}</span>
                  <div>
                    <h3 class="font-bold text-white">{step.title}</h3>
                    <p class="mt-1 text-sm leading-6 text-gray-400">{step.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="mt-6 rounded-3xl border border-white/10 bg-black/20 p-4 sm:mt-8 sm:p-5 md:p-6">
          <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
              <h3 class="text-xl font-bold text-white sm:text-2xl">{content.architecture.diagram.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-400">
                {content.architecture.diagram.description}
              </p>
            </div>
          </div>

          <div class="mt-6 grid gap-3 md:grid-cols-[0.9fr_auto_1.15fr_auto_0.9fr] md:items-center">
            <article class="rounded-2xl border border-sky-300/20 bg-sky-300/10 p-4 text-center">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-100">{content.architecture.diagram.browser}</p>
              <div class="mt-4 grid grid-cols-2 gap-2 text-xs text-sky-50/90">
                {content.architecture.diagram.browserDetails.map((item) => (
                  <span class="rounded-full border border-sky-200/20 bg-sky-950/60 px-3 py-1.5">{item}</span>
                ))}
              </div>
            </article>

            <div class="hidden text-2xl font-bold text-sky-200 md:block" aria-hidden="true">→</div>

            <article class="rounded-2xl border border-yellow-300/20 bg-yellow-300/10 p-4">
              <p class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-yellow-100">{content.architecture.diagram.app}</p>
              <ul class="mt-4 grid gap-2 text-sm text-gray-200 sm:grid-cols-2">
                {content.architecture.diagram.appDetails.map((item) => (
                  <li class="rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2 text-center">{item}</li>
                ))}
              </ul>
            </article>

            <div class="hidden text-2xl font-bold text-sky-200 md:block" aria-hidden="true">→</div>

            <article class="rounded-2xl border border-emerald-300/20 bg-emerald-300/10 p-4">
              <p class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-emerald-100">{content.architecture.diagram.data}</p>
              <ul class="mt-4 grid gap-2 text-sm text-gray-200">
                {content.architecture.diagram.dataDetails.map((item) => (
                  <li class="rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2 text-center">{item}</li>
                ))}
              </ul>
            </article>
          </div>

          <div class="mt-3 grid gap-3 md:grid-cols-[0.9fr_auto_1.15fr_auto_0.9fr] md:items-center">
            <div class="hidden md:block" aria-hidden="true"></div>
            <div class="hidden md:block" aria-hidden="true"></div>
            <article class="rounded-2xl border border-violet-300/20 bg-violet-300/10 p-4">
              <p class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-violet-100">{content.architecture.diagram.services}</p>
              <ul class="mt-4 grid gap-2 text-sm text-gray-200 sm:grid-cols-2">
                {content.architecture.diagram.serviceDetails.map((item) => (
                  <li class="rounded-xl border border-white/10 bg-slate-950/70 px-3 py-2 text-center">{item}</li>
                ))}
              </ul>
            </article>
            <div class="hidden md:block" aria-hidden="true"></div>
            <div class="hidden md:block" aria-hidden="true"></div>
          </div>
        </div>

      </section>

      <section class="relative mt-10 overflow-hidden rounded-3xl border border-sky-300/25 bg-slate-950/80 p-5 shadow-2xl shadow-sky-950/20 sm:mt-14 sm:p-6 md:p-8" aria-labelledby="ukiyo-calculator-title">
        <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-sky-300/80 to-transparent" aria-hidden="true"></div>
        <div class="absolute -left-28 -top-24 size-64 rounded-full bg-sky-300/10 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -right-24 bottom-0 size-64 rounded-full bg-emerald-300/10 blur-3xl" aria-hidden="true"></div>

        <div class="relative grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.calculator.eyebrow}</p>
            <h2 id="ukiyo-calculator-title" class="mt-3 text-balance text-2xl font-bold text-white sm:text-3xl">{content.calculator.title}</h2>
            <p class="mt-4 text-pretty text-sm leading-7 text-gray-300 sm:text-base">
              {content.calculator.description}
            </p>

            <div class="mt-6 rounded-2xl border border-sky-300/20 bg-sky-300/[0.08] p-4 sm:p-5">
              <h3 class="text-xl font-bold text-white">{content.calculator.proofTitle}</h3>
              <div class="mt-4 grid gap-3">
                {calculatorProofItems.map((item) => (
                  <article class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                    <h4 class="font-bold text-sky-50">{item.title}</h4>
                    <p class="mt-2 text-sm leading-6 text-gray-300">{item.description}</p>
                  </article>
                ))}
              </div>
            </div>
          </div>

          <div class="grid gap-4">
            <figure class="overflow-hidden rounded-3xl border border-sky-300/20 bg-black/30 shadow-2xl shadow-black/20">
              <img
                src={pricingScreenshot.src}
                alt={pricingScreenshot.alt}
                loading="lazy"
                class="aspect-[4/3] w-full object-cover object-top sm:aspect-[16/10]"
              />
              <figcaption class="border-t border-white/10 p-4 sm:p-5">
                <h3 class="text-xl font-bold text-white">{content.calculator.finalTitle}</h3>
                <p class="mt-2 text-sm leading-6 text-gray-300">{content.calculator.finalDescription}</p>
              </figcaption>
            </figure>

            <div class="grid gap-3 md:grid-cols-2">
              {calculationInputs.map((item) => (
                <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-sm leading-6 text-gray-300">
                  {item}
                </div>
              ))}
            </div>

            <ul class="grid gap-3 text-sm leading-6 text-gray-300 md:grid-cols-2">
              {finalPriceFeatures.map((item) => (
                <li class="flex gap-3 rounded-2xl border border-sky-300/15 bg-sky-950/25 p-4">
                  <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="relative mt-10 overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-14 sm:p-6 md:p-8" aria-labelledby="ukiyo-backend-title">
        <div class="absolute -right-24 -top-24 size-64 rounded-full bg-sky-300/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.backend.eyebrow}</p>
            <h2 id="ukiyo-backend-title" class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.backend.title}</h2>
          </div>
          <p class="max-w-md text-pretty text-sm leading-6 text-gray-300">
            {content.backend.description}
          </p>
        </div>

        <div class="relative mt-6 grid gap-3 sm:mt-8 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
          {backendDecisions.map((decision) => (
            <article class="rounded-2xl border border-white/10 bg-slate-950/75 p-4 shadow-xl shadow-black/10 sm:p-5">
              <h3 class="text-lg font-bold leading-6 text-white">{decision.title}</h3>
              <p class="mt-3 text-sm leading-6 text-gray-400">{decision.description}</p>
            </article>
          ))}
        </div>

        <div class="relative mt-6 rounded-3xl border border-sky-300/15 bg-slate-950/70 p-4 sm:mt-8 sm:p-5 md:p-6">
          <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
            <div>
              <h3 class="text-xl font-bold text-white sm:text-2xl">{content.backend.detailsTitle}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-400">{content.backend.detailsDescription}</p>
            </div>
          </div>

          <div class="mt-5 grid gap-3">
            <details class="group rounded-2xl border border-white/10 bg-black/20 p-2 open:border-sky-300/25 open:bg-sky-300/[0.06] sm:p-3">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-3 text-lg font-bold text-white marker:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:px-4">
                <span>{content.backend.dataModelDetailsTitle}</span>
                <span class="text-xl leading-none text-sky-200 transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="px-2 pb-3 sm:px-3">
                <p class="mt-3 max-w-3xl text-sm leading-6 text-gray-400">{dataModelDiagram.description}</p>
                <ol class="mt-5 grid gap-3" aria-label={dataModelDiagram.ariaLabel}>
                  {dataModelDiagram.flows.map((flow) => (
                    <li class="grid gap-2 rounded-2xl border border-white/10 bg-slate-950/70 p-3 sm:grid-cols-[1fr_auto_1fr_auto_1fr] sm:items-center sm:p-4">
                      {flow.map((node, nodeIndex) => (
                        <>
                          <span class="rounded-xl border border-sky-200/15 bg-white/[0.04] px-3 py-2.5 text-center font-mono text-xs font-semibold leading-5 text-sky-50 sm:text-sm">
                            {node}
                          </span>
                          {nodeIndex < flow.length - 1 && (
                            <span class="hidden px-1 text-center text-lg font-bold text-sky-200/70 sm:block" aria-hidden="true">→</span>
                          )}
                        </>
                      ))}
                    </li>
                  ))}
                </ol>
                <ol class="mt-5 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
                  {dataModelGroups.map((group, index) => (
                    <li class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                      <h4 class="font-bold text-white">0{index + 1}. {group.title}</h4>
                      <ul class="mt-3 flex flex-wrap gap-2">
                        {group.items.map((item) => (
                          <li>
                            <code class="block break-words rounded-lg border border-white/10 bg-black/30 px-2.5 py-2 font-mono text-[0.7rem] leading-none text-gray-200 sm:text-xs">
                              {item}
                            </code>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ol>
              </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-black/20 p-2 open:border-sky-300/25 open:bg-sky-300/[0.06] sm:p-3">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-3 text-lg font-bold text-white marker:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:px-4">
                <span>{content.backend.stackDetailsTitle}</span>
                <span class="text-xl leading-none text-sky-200 transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <div class="px-2 pb-3 sm:px-3">
                <div class="mt-5 grid gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-4">
                  {stackLayers.map((layer) => (
                    <article class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                      <h4 class="text-base font-bold text-white">{layer.layer}</h4>
                      <ul class="mt-3 space-y-2 text-sm text-gray-300">
                        {layer.items.map((item) => (
                          <li class="flex gap-3">
                            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </article>
                  ))}
                </div>
                <ul class="mt-5 flex flex-wrap gap-2" aria-label={content.backend.stackAriaLabel}>
                  {stack.map((item) => (
                    <li class="rounded-full border border-sky-300/20 bg-sky-300/10 px-3 py-1.5 text-xs font-medium text-sky-100 sm:text-sm">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </details>

            <details class="group rounded-2xl border border-white/10 bg-black/20 p-2 open:border-sky-300/25 open:bg-sky-300/[0.06] sm:p-3">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-3 text-lg font-bold text-white marker:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 sm:px-4">
                <span>{content.backend.implementationDetailsTitle}</span>
                <span class="text-xl leading-none text-sky-200 transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <ul class="mt-4 space-y-3 px-2 pb-3 text-sm leading-6 text-gray-300 sm:px-3 sm:text-base">
                {backendHighlights.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        </div>
      </section>

      <section class="mt-10 rounded-3xl border border-sky-300/20 bg-slate-950/70 p-5 sm:mt-14 sm:p-6 md:p-8">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.infrastructure.eyebrow}</p>
        <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.infrastructure.title}</h2>
        <p class="mt-4 max-w-3xl text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-base">
          {content.infrastructure.description}
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {infraItems.map((item) => (
            <article class="rounded-2xl border border-white/10 bg-slate-950/75 p-4 shadow-xl shadow-black/10 sm:p-5">
              <h3 class="font-bold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-gray-400">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-10 sm:p-6 md:p-8">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.operationalProof.eyebrow}</p>
        <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.operationalProof.title}</h2>
        <p class="mt-4 max-w-3xl text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-base">
          {content.operationalProof.description}
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {operationalItems.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-200/80">{item.label}</p>
              <p class="mt-2 text-sm font-bold leading-6 text-white">{item.value}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-10 sm:p-6 md:p-8">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.limitations.eyebrow}</p>
        <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.limitations.title}</h2>
        <p class="mt-4 max-w-3xl text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-base">
          {content.limitations.description}
        </p>
        <ul class="mt-5 grid gap-3 text-sm leading-6 text-gray-300 sm:mt-6 md:grid-cols-2">
          {limitationItems.map((item) => (
            <li class="flex gap-3 rounded-2xl border border-white/10 bg-slate-950/70 p-4">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-5 sm:mt-10 sm:p-6 md:p-8">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.lessonsLearned.eyebrow}</p>
        <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">{content.lessonsLearned.title}</h2>
        <p class="mt-4 max-w-3xl text-pretty text-sm leading-7 text-gray-300 sm:mt-5 sm:text-base">
          {content.lessonsLearned.description}
        </p>
        <ul class="mt-5 grid gap-3 text-sm leading-6 text-gray-300 sm:mt-6 md:grid-cols-2">
          {lessonsItems.map((item) => (
            <li class="flex gap-3 rounded-2xl border border-white/10 bg-slate-950/70 p-4">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-10 sm:mt-14">
        <details class="group rounded-3xl border border-white/10 bg-white/[0.03] p-4 open:border-sky-300/20 open:bg-slate-950/60 sm:p-5 md:p-6">
          <summary class="flex min-h-12 cursor-pointer list-none flex-col gap-3 rounded-2xl px-2 py-1 marker:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300 md:flex-row md:items-end md:justify-between">
            <span>
              <span class="block text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-sky-200/80 sm:text-sm sm:tracking-[0.24em]">{content.media.eyebrow}</span>
              <span class="mt-3 block text-2xl font-bold text-white sm:text-3xl">{content.media.title}</span>
            </span>
            <span class="flex items-center gap-3 text-sm leading-6 text-gray-400 md:max-w-md">
              <span>{content.media.description}</span>
              <span class="text-xl leading-none text-sky-200 transition group-open:rotate-45" aria-hidden="true">+</span>
            </span>
          </summary>

          <div class="mt-6 grid gap-6 sm:mt-8 sm:gap-8">
            {mediaGroups.map((group) => (
              <section aria-label={group.title}>
                <h3 class="text-lg font-bold text-white sm:text-xl">{group.title}</h3>
                <div class="mt-4 grid gap-4 sm:gap-6 md:grid-cols-2">
                  {group.screenshots.map((screenshot) => (
                    <figure class="overflow-hidden rounded-3xl border border-white/10 bg-slate-950/80 shadow-xl shadow-black/20">
                      <img
                        src={screenshot.src}
                        alt={screenshot.alt}
                        loading="lazy"
                        class="aspect-[4/3] w-full object-cover object-top sm:aspect-[16/10]"
                      />
                      <figcaption class="border-t border-white/10 p-4 sm:p-5">
                        <h4 class="text-lg font-bold text-white">{screenshot.title}</h4>
                        <p class="mt-2 text-sm leading-6 text-gray-400">{screenshot.description}</p>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </details>
      </section>
    </article>
  </main>
</Layout>
